/* pages/profile-edit/profile-edit.wxss - 编辑资料 - 完全照搬Figma设计 */
.profile-edit {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

.profile-edit__body {
  flex: 1;
  overflow-y: auto;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 头像选择 */
.profile-edit__avatar-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.profile-edit__avatar {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mint-grad);
  font-size: 88rpx;
  box-shadow: 0 8rpx 40rpx rgba(78,205,196,0.4);
  border: 6rpx solid #fff;
}

.profile-edit__avatar-img {
  width: 100%;
  height: 100%;
}

.profile-edit__avatar-hint {
  font-size: 24rpx;
  color: var(--text-sub);
}

.profile-edit__avatar-btn {
  background: none;
  border: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.profile-edit__avatar-btn::after { border: none; }

/* 表单 */
.profile-edit__form {
  background: var(--card);
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.profile-edit__field {
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--border);
}

.profile-edit__field:last-child { border-bottom: none; }

.profile-edit__field-label {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.profile-edit__field-input {
  width: 100%;
  border: none;
  outline: none;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  background: transparent;
  box-sizing: border-box;
  height: 64rpx;
  line-height: 64rpx;
}

.profile-edit__field-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-sub);
}

.profile-edit__save {
  width: 100%;
  padding: 30rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(78,205,196,0.42);
  transition: background 0.3s;
  margin: 0;
}

.profile-edit__save::after { border: none; }
.profile-edit__save--normal { background: var(--mint-grad); }
.profile-edit__save--saved { background: var(--green); }