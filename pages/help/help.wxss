/* pages/help/help.wxss - 帮助反馈 - 完全照搬Figma设计 */
.help {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

.help__body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.help__section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.help__faq-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.help__faq-item {
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  border: 2rpx solid var(--border);
}

.help__faq-item.is-open {
  border-color: var(--mint);
}

.help__faq-q {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.help__faq-q-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--mint-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--mint);
}

.help__faq-q-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.help__faq-q-arrow {
  color: var(--text-sub);
  font-size: 32rpx;
  transition: transform 0.2s;
}

.help__faq-q-arrow.is-open {
  transform: rotate(90deg);
}

.help__faq-a {
  padding: 0 32rpx 28rpx;
  display: flex;
  gap: 20rpx;
}

.help__faq-a-badge {
  width: 48rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  padding-top: 2rpx;
}

.help__faq-a-badge-inner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--green);
}

.help__faq-a-text {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
  flex: 1;
}

/* 意见反馈 */
.help__feedback {
  background: var(--card);
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.help__feedback-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
}

.help__feedback-input {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--border);
  font-size: 26rpx;
  color: var(--text);
  background: var(--bg);
  outline: none;
  box-sizing: border-box;
  font-family: inherit;
  min-height: 200rpx;
}

.help__feedback-input:focus {
  border-color: var(--mint);
}

.help__feedback-submit {
  margin-top: 20rpx;
  width: 100%;
  padding: 26rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(78,205,196,0.42);
  margin: 0;
}

.help__feedback-submit::after { border: none; }
.help__feedback-submit--active { background: var(--mint-grad); }
.help__feedback-submit--disabled { background: var(--border); color: var(--text-sub); }
.help__feedback-submit--sent { background: var(--green); }