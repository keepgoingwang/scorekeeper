/* pages/settle-report/settle-report.wxss - 结算报告 - 完全照搬Figma设计 */
.settle-report {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

.settle-report__header {
  background: var(--mint-grad);
  padding: 56rpx 32rpx 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.settle-report__title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}

.settle-report__room {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.settle-report__body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.settle-report__section {
  background: var(--card);
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.settle-report__section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.settle-report__rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F8F8F8;
}

.settle-report__rank-item:last-child { border-bottom: none; }

.settle-report__rank-item--win { background: #EDFBF0; border-radius: 32rpx; padding: 20rpx; border-color: #C2EACC; }
.settle-report__rank-item--lose { background: var(--red-light); border-radius: 32rpx; padding: 20rpx; border-color: #FFCECE; }
.settle-report__rank-item--normal { }

.settle-report__rank-no {
  font-size: 44rpx;
  width: 52rpx;
  text-align: center;
}

.settle-report__rank-emoji {
  font-size: 44rpx;
}

.settle-report__rank-info {
  flex: 1;
}

.settle-report__rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.settle-report__rank-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  color: #fff;
  display: inline-block;
  margin-top: 4rpx;
}

.settle-report__rank-score {
  font-size: 36rpx;
  font-weight: 800;
}

/* 转账方案 */
.settle-report__transfer {
  background: var(--mode-bar);
  border-radius: 32rpx;
  padding: 28rpx;
  border: 2rpx solid var(--border);
  margin-bottom: 24rpx;
}

.settle-report__transfer-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}

.settle-report__transfer-item {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 2.2;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.settle-report__transfer-from {
  background: #FFE8E8;
  color: var(--red);
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.settle-report__transfer-to {
  background: var(--mint-light);
  color: var(--mint);
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.settle-report__transfer-amount {
  color: var(--orange);
  font-weight: 800;
}

.settle-report__actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-bottom: 32rpx;
}

.settle-report__share-btn {
  width: 100%;
  padding: 30rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  background: linear-gradient(135deg, #FFD93D 0%, #FF9F45 100%);
  color: #333;
  box-shadow: 0 8rpx 32rpx rgba(255,217,61,0.4);
  margin: 0;
}

.settle-report__share-btn::after { border: none; }

.settle-report__dissolve-btn {
  width: 100%;
  padding: 26rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: 3rpx solid var(--border);
  background: var(--bg);
  color: var(--red);
  margin: 0;
}

.settle-report__dissolve-btn::after { border: none; }

.settle-report__empty {
  padding: 80rpx 0;
}

.settle-report__loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
}