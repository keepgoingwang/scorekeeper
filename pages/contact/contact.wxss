/* pages/contact/contact.wxss - 联系我们 - 完全照搬Figma设计 */
.contact {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

.contact__header {
  background: var(--mint-grad);
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.contact__back {
  font-size: 28rpx;
  color: #fff;
  padding: 0;
  background: none;
  border: none;
  margin: 0;
  line-height: 1;
}

.contact__back::after { border: none; }

.contact__header-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.contact__body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.contact__section {
  background: var(--card);
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.contact__section-header {
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--border);
}

.contact__section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.contact__item {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  border-bottom: 2rpx solid var(--border);
}

.contact__item:last-child { border-bottom: none; }

.contact__item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--mint-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.contact__item-info {
  flex: 1;
}

.contact__item-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.contact__item-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.contact__item-action {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--mint);
  background: var(--mint-light);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.contact__item-arrow {
  color: var(--text-sub);
  font-size: 36rpx;
}

/* 版本信息行 */
.contact__info-row {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--border);
}

.contact__info-row:last-child { border-bottom: none; }

.contact__info-label {
  font-size: 26rpx;
  color: var(--text-sub);
  flex: 1;
}

.contact__info-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

/* 法律链接 */
.contact__link-row {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--border);
}

.contact__link-row:last-child { border-bottom: none; }

.contact__link-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

/* 品牌区 */
.contact__brand {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.contact__brand-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.contact__brand-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
}

.contact__brand-slogan {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}