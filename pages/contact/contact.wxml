<!--pages/contact/contact.wxml - 联系我们 - 完全照搬Figma设计-->
<view class="contact">
  <view class="contact__header">
    <button class="contact__back" bindtap="onBack">← 返回</button>
    <text class="contact__header-title">📋 联系我们</text>
  </view>

  <view class="contact__body">
    <!-- 客服支持 -->
    <view class="contact__section">
      <view class="contact__section-header">
        <text class="contact__section-title">🎧 客服支持</text>
      </view>
      <view class="contact__item" bindtap="onCopyWechat">
        <view class="contact__item-icon">💬</view>
        <view class="contact__item-info">
          <text class="contact__item-label">在线客服</text>
          <text class="contact__item-sub">工作日 10:00–18:00</text>
        </view>
        <text class="contact__item-action">联系</text>
      </view>
      <view class="contact__item" bindtap="onCopyEmail">
        <view class="contact__item-icon">📧</view>
        <view class="contact__item-info">
          <text class="contact__item-label">邮件反馈</text>
          <text class="contact__item-sub">{{contactInfo.email}}</text>
        </view>
        <text class="contact__item-arrow">›</text>
      </view>
      <view class="contact__item" bindtap="onCopyQq">
        <view class="contact__item-icon">🐧</view>
        <view class="contact__item-info">
          <text class="contact__item-label">官方 QQ 群</text>
          <text class="contact__item-sub">加群号：{{contactInfo.qq}}</text>
        </view>
        <text class="contact__item-arrow">›</text>
      </view>
    </view>

    <!-- 版本信息 -->
    <view class="contact__section">
      <view class="contact__section-header">
        <text class="contact__section-title">📱 版本信息</text>
      </view>
      <view class="contact__info-row">
        <text class="contact__info-label">当前版本</text>
        <text class="contact__info-value">v{{version}}</text>
      </view>
      <view class="contact__info-row">
        <text class="contact__info-label">更新日期</text>
        <text class="contact__info-value">2026-07-20</text>
      </view>
      <view class="contact__info-row">
        <text class="contact__info-label">设备信息</text>
        <text class="contact__info-value">iOS 17.4</text>
      </view>
    </view>

    <!-- 法律信息 -->
    <view class="contact__section">
      <view class="contact__link-row" bindtap="onShowPrivacy">
        <text class="contact__link-label">隐私政策</text>
        <text class="contact__item-arrow">›</text>
      </view>
      <view class="contact__link-row" bindtap="onShowAgreement">
        <text class="contact__link-label">用户协议</text>
        <text class="contact__item-arrow">›</text>
      </view>
      <view class="contact__link-row">
        <text class="contact__link-label">关于我们</text>
        <text class="contact__item-arrow">›</text>
      </view>
    </view>

    <!-- 品牌 -->
    <view class="contact__brand">
      <text class="contact__brand-icon">🀄</text>
      <text class="contact__brand-name">牌桌记分</text>
      <text class="contact__brand-slogan">让每一局都有迹可循</text>
    </view>
  </view>
</view>