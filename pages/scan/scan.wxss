/* pages/scan/scan.wxss - 扫码页 - 基于Figma设计重构 */
.scan {
  min-height: 100vh;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scan__container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.scan__icon {
  font-size: 80rpx;
  opacity: 0.8;
}

.scan__hint {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.scan__loading {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.scan__loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4ECDC4;
  animation: scanPulse 1.2s infinite;
}

.scan__loading-dot:nth-child(2) { animation-delay: 0.2s; }
.scan__loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes scanPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.scan__cancel {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
  border-radius: 40rpx;
}