<!--pages/login/login.wxml - 沉浸式登录：昵称一步 + 协议勾选-->
<view class="login">
  <!-- 品牌 hero -->
  <view class="login__hero" style="padding-top: {{headerPaddingTop}}px;">
    <view class="login__hero-circle login__hero-circle--1"></view>
    <view class="login__hero-circle login__hero-circle--2"></view>
    <view class="login__logo">🀄</view>
    <text class="login__title">牌桌记分</text>
    <text class="login__desc">打牌计分，一键搞定</text>
  </view>

  <!-- 登录面板：昵称输入（自动聚焦弹微信昵称建议）+ 登录按钮 -->
  <view class="login__panel">
    <input
      class="login__nickname"
      type="nickname"
      placeholder="点击此处使用微信昵称"
      placeholder-class="login__nickname-ph"
      focus="{{autoFocus}}"
      maxlength="10"
      bindinput="onNicknameInput"
      bindconfirm="onLogin"
    />
    <button class="login__btn" bindtap="onLogin" loading="{{loading}}">
      <text class="login__btn-text">微信一键登录</text>
    </button>
    <text class="login__tip">点击上方输入框，可直接使用微信昵称</text>
  </view>

  <!-- 协议勾选 -->
  <view class="login__footer">
    <view class="login__agree-row" bindtap="onToggleAgree">
      <view class="login__checkbox {{agreed ? 'login__checkbox--checked' : ''}}">
        <text wx:if="{{agreed}}" class="login__checkbox-icon">✓</text>
      </view>
      <text class="login__agree-text">我已阅读并同意<text class="login__agree-link" catchtap="onOpenPage" data-url="/pages/agreement/agreement">《用户协议》</text>与<text class="login__agree-link" catchtap="onOpenPage" data-url="/pages/privacy/privacy">《隐私政策》</text></text>
    </view>
  </view>
</view>
