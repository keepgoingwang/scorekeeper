<!--pages/login/login.wxml - 简化版登录页 - 一键微信登录 -->
<view class="login">
  <view class="login__header">
    <view class="login__logo-wrap">
      <text class="login__logo">🀄</text>
    </view>
    <text class="login__title">牌桌记分</text>
    <text class="login__desc">打牌计分，一键搞定</text>
  </view>

  <view class="login__card">
    <!-- 微信登录按钮（点击即触发 chooseAvatar + 自动填入昵称） -->
    <button class="login__btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <text class="login__btn-icon">💬</text>
      <text class="login__btn-text">微信一键登录</text>
    </button>

    <!-- 隐藏的昵称输入框，用于自动获取微信昵称 -->
    <input class="login__nickname-hidden" type="nickname" bindinput="onNicknameInput" />
  </view>

  <view class="login__footer">
    <text class="login__hint">
      登录即代表同意
      <text class="login__hint-link" data-url="/pages/agreement/agreement" bindtap="onOpenPage">《用户协议》</text>
      与
      <text class="login__hint-link" data-url="/pages/privacy/privacy" bindtap="onOpenPage">《隐私政策》</text>
    </text>
  </view>
</view>