<!--pages/login/login.wxml - 沉浸式一键登录（零授权弹窗）-->
<view class="login">
  <!-- 品牌 hero -->
  <view class="login__hero" style="padding-top: {{headerPaddingTop}}px;">
    <view class="login__hero-circle login__hero-circle--1"></view>
    <view class="login__hero-circle login__hero-circle--2"></view>
    <view class="login__logo">🀄</view>
    <text class="login__title">牌桌记分</text>
    <text class="login__desc">打牌计分，一键搞定</text>
  </view>

  <!-- 登录面板（浮在 hero 下沿） -->
  <view class="login__panel">
    <button class="login__btn" bindtap="onLogin" loading="{{loading}}">
      <text class="login__btn-text">微信一键登录</text>
    </button>
    <text class="login__tip">首次登录使用默认头像与昵称，可在「我的」修改</text>
  </view>

  <!-- 协议 -->
  <view class="login__footer">
    <text class="login__hint">
      登录即代表同意
      <text class="login__hint-link" data-url="/pages/agreement/agreement" bindtap="onOpenPage">《用户协议》</text>
      与
      <text class="login__hint-link" data-url="/pages/privacy/privacy" bindtap="onOpenPage">《隐私政策》</text>
    </text>
  </view>
</view>
