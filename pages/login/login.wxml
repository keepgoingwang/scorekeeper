<!--pages/login/login.wxml - 简化版登录页 -->
<view class="login">
  <view class="login__header">
    <view class="login__logo-wrap">
      <text class="login__logo">🀄</text>
    </view>
    <text class="login__title">牌桌记分</text>
    <text class="login__desc">打牌计分，一键搞定</text>
  </view>

  <view class="login__card">
    <!-- 头像选择 -->
    <button class="login__avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatar}}" class="login__avatar-img" src="{{avatar}}" mode="aspectFill" />
      <text wx:else class="login__avatar-placeholder">🤠</text>
    </button>

    <!-- 昵称输入（type="nickname" 自动填充微信昵称） -->
    <input class="login__nickname" type="nickname" placeholder="你的微信昵称" bindinput="onNicknameInput" />

    <!-- 登录按钮 -->
    <button class="login__btn" bindtap="onLogin" loading="{{loading}}">
      <text class="login__btn-text">微信登录</text>
    </button>
  </view>

  <view class="login__footer">
    <text class="login__hint">
      登录即代表同意
      <text class="login__hint-link" data-url="/pages/agreement/agreement" bindtap="onOpenPage">《用户协议》</text>
      与
      <text class="login__hint-link" data-url="/pages/privacy/privacy" bindtap="onOpenPage">《隐私政策》</text>
    </text>
  </view>
</view>