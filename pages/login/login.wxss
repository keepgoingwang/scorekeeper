/* pages/login/login.wxss - 沉浸式一键登录 */
.login {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: #F8FAFB;
}

/* ===== 品牌 hero ===== */
.login__hero {
  width: 100%;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  padding: 40rpx 48rpx 132rpx;
  border-radius: 0 0 64rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.login__hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.10);
}
.login__hero-circle--1 { width: 240rpx; height: 240rpx; top: -60rpx; right: -60rpx; }
.login__hero-circle--2 { width: 160rpx; height: 160rpx; bottom: 40rpx; left: -50rpx; background: rgba(255,255,255,0.08); }

.login__logo {
  width: 132rpx;
  height: 132rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.18), inset 0 -6rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 28rpx;
  position: relative;
}

.login__title {
  font-size: 44rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  position: relative;
}

.login__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.88);
  position: relative;
}

/* ===== 登录面板（浮起） ===== */
.login__panel {
  width: 100%;
  margin-top: -80rpx;
  padding: 56rpx 48rpx 40rpx;
  background: #FFFFFF;
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 2;
  box-sizing: border-box;
}

/* 主按钮 */
.login__btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 36rpx rgba(78,205,196,0.42);
  border: none;
  margin: 0;
  padding: 0;
}
.login__btn::after { border: none; }
.login__btn:active { transform: scale(0.98); opacity: 0.95; }
.login__btn-text { color: #FFFFFF; }

.login__tip {
  font-size: 24rpx;
  color: #9AA5AC;
  text-align: center;
  line-height: 1.5;
}

/* ===== 协议 ===== */
.login__footer {
  margin-top: 40rpx;
  padding: 0 48rpx;
  text-align: center;
}
.login__hint {
  font-size: 22rpx;
  color: #B0B8BE;
  line-height: 1.7;
}
.login__hint-link { color: #4ECDC4; }
