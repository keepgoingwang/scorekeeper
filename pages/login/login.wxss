/* pages/login/login.wxss - 简化版登录页 */
.login {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F8F7 0%, #F8FAFB 50%);
  padding: 0 48rpx;
}

.login__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 48rpx;
}

.login__logo-wrap {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 48rpx rgba(78,205,196,0.35);
  margin-bottom: 24rpx;
}

.login__logo { font-size: 56rpx; }

.login__title {
  font-size: 36rpx;
  font-weight: 900;
  color: #2C3E50;
  letter-spacing: 2rpx;
}

.login__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7F8C8D;
}

.login__card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 微信登录按钮 - 大号品牌按钮 */
.login__btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(78,205,196,0.35);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  padding: 0;
}

.login__btn::after { border: none; }

.login__btn:active { transform: scale(0.97); opacity: 0.9; }

.login__btn-icon { font-size: 36rpx; }

.login__btn-text { font-size: 30rpx; }

/* 昵称输入框 - 头像选择后显示，点微信建议即填入 */
.login__nickname {
  width: 100%;
  margin-top: 36rpx;
  padding: 30rpx 28rpx;
  background: #F8FAFB;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
  border: 3rpx solid #E8ECEF;
  color: #2C3E50;
  text-align: center;
  transition: border-color 0.2s;
}

.login__nickname:focus {
  border-color: #4ECDC4;
}

.login__footer {
  margin-top: 48rpx;
  text-align: center;
}

.login__hint {
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.6;
}

.login__hint-link {
  color: #4ECDC4;
}