/* pages/login/login.wxss - 登录页 */
.login {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F8F7 0%, #F8FAFB 50%);
  padding: 0 48rpx;
}

.login__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0 48rpx;
}

.login__logo-wrap {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 48rpx rgba(78,205,196,0.35);
  margin-bottom: 24rpx;
}

.login__logo { font-size: 56rpx; }

.login__title {
  font-size: 36rpx;
  font-weight: 900;
  color: #2C3E50;
  letter-spacing: 2rpx;
}

.login__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7F8C8D;
}

.login__card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

/* 头像选择 */
.login__avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: #E8F8F7;
  border: 6rpx solid #E8F8F7;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(78,205,196,0.15);
}

.login__avatar-btn::after { border: none; }

.login__avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.login__avatar-placeholder {
  font-size: 64rpx;
}

/* 昵称输入框 */
.login__nickname {
  width: 100%;
  padding: 30rpx 28rpx;
  background: #F8FAFB;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
  border: 3rpx solid #E8ECEF;
  color: #2C3E50;
  text-align: center;
  transition: border-color 0.2s;
}

.login__nickname:focus {
  border-color: #4ECDC4;
}

/* 登录按钮 */
.login__btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(78,205,196,0.35);
  border: none;
  margin: 0;
  padding: 0;
}

.login__btn::after { border: none; }
.login__btn:active { opacity: 0.9; }

.login__footer {
  margin-top: 48rpx;
  text-align: center;
}

.login__hint {
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.6;
}

.login__hint-link {
  color: #4ECDC4;
}