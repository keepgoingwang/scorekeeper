/* pages/login/login.wxss - 登录页 - 修复版 */
.login {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F8F7 0%, #F8FAFB 50%);
  padding: 0 48rpx;
}

.login__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 32rpx;
}

.login__logo-wrap {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 48rpx rgba(78,205,196,0.35);
  margin-bottom: 24rpx;
}

.login__logo { font-size: 56rpx; }

.login__title {
  font-size: 36rpx;
  font-weight: 900;
  color: #2C3E50;
  letter-spacing: 2rpx;
}

.login__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7F8C8D;
}

.login__card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像 - view包裹button确保正圆形 */
.login__avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid #E8F8F7;
  box-shadow: 0 4rpx 16rpx rgba(78,205,196,0.15);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login__avatar {
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #E8F8F7;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  min-width: 0;
  box-sizing: border-box;
}

.login__avatar::after { border: none; }

.login__avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.login__avatar-tip {
  font-size: 24rpx;
  color: #7F8C8D;
  text-align: center;
  display: block;
  width: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
  line-height: 1.4;
}

.login__avatar-label {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #4ECDC4;
  margin-top: 12rpx;
  font-weight: 500;
}

/* 昵称输入框 - 加高防遮挡 */
.login__nickname {
  width: 100%;
  margin-top: 36rpx;
  padding: 36rpx 28rpx;
  background: #F8FAFB;
  border-radius: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 3rpx solid transparent;
  transition: border-color 0.2s;
  color: #2C3E50;
  height: 100rpx;
  line-height: 1;
}

.login__nickname:focus {
  border-color: #4ECDC4;
}

.login__submit {
  width: 100%;
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7D1 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(78,205,196,0.35);
  border: none;
  transition: transform 0.15s;
}

.login__submit:active { transform: scale(0.97); }
.login__submit::after { border: none; }

.login__footer {
  margin-top: 40rpx;
  text-align: center;
}

.login__hint {
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.6;
}

.login__hint-link {
  color: #4ECDC4;
}