<!--pages/flow/flow.wxml - 流水记录 - 完全照搬Figma设计-->
<view class="flow">
  <view class="flow__header">
    <text class="flow__header-room">房间 {{roomNo}}</text>
  </view>

  <!-- 汇总栏 -->
  <view class="flow__summary">
    <view class="flow__summary-item">
      <text class="flow__summary-label">总支出</text>
      <text class="flow__summary-value" style="color:#FF6B6B;">{{summary.expenseText}}</text>
    </view>
    <view class="flow__summary-item">
      <text class="flow__summary-label">总收入</text>
      <text class="flow__summary-value" style="color:#6BCB77;">{{summary.incomeText}}</text>
    </view>
    <view class="flow__summary-item">
      <text class="flow__summary-label">共</text>
      <text class="flow__summary-value" style="color:var(--text-sub);">{{summary.roundsText}}</text>
    </view>
  </view>

  <!-- 时间线 -->
  <view class="flow__timeline">
    <view wx:if="{{loading && list.length === 0}}" class="flow__loading">加载中…</view>
    <view wx:elif="{{list.length === 0}}" class="flow__empty">
      <empty-state text="暂无流水记录"></empty-state>
    </view>
    <scroll-view wx:else class="flow__list" scroll-y bindscrolltolower="onLoadMore" enhanced show-scrollbar="{{false}}">
      <view
        class="flow__item"
        wx:for="{{list}}"
        wx:key="_id"
      >
        <view
          class="flow__item-icon"
          style="background:{{item.iconColor || 'rgba(78,205,196,0.15)'}};border:{{item.iconBorder || '2rpx solid rgba(78,205,196,0.3)'}};"
        >{{item.typeIcon || '💸'}}</view>
        <text class="flow__item-text">{{item.memo || item.typeText}}</text>
        <text class="flow__item-time">{{item.timeText}}</text>
      </view>
      <view wx:if="{{loading}}" class="flow__load-more">加载中…</view>
      <view wx:elif="{{!hasMore && list.length > 0}}" class="flow__load-more">— 没有更多了 —</view>
    </scroll-view>
  </view>
</view>