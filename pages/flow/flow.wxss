/* pages/flow/flow.wxss - 流水记录 - 完全照搬Figma设计 */
.flow {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

.flow__header {
  background: var(--mint-grad);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.flow__header-room {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* 汇总栏 */
.flow__summary {
  background: rgba(78,205,196,0.1);
  padding: 20rpx 32rpx;
  display: flex;
  gap: 32rpx;
  border-bottom: 2rpx solid var(--border);
  flex-shrink: 0;
}

.flow__summary-item {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.flow__summary-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.flow__summary-value {
  font-size: 24rpx;
  font-weight: 800;
}

/* 时间线 */
.flow__timeline {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

.flow__list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.flow__item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.flow__item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.flow__item-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.flow__item-time {
  font-size: 22rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.flow__loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
}

.flow__empty {
  padding: 80rpx 0;
}

.flow__load-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--text-sub);
}