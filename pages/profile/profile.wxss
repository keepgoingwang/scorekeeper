/* pages/profile/profile.wxss - 我的页面 - 完全照搬Figma设计 */
.profile {
  flex: 1;
  overflow-y: auto;
  background: var(--bg);
}

/* 头部渐变 */
.profile__header {
  background: var(--mint-grad);
  padding: 20rpx 40rpx 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.profile__header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

/* 用户卡片 - 浮动在头部下方 */
.profile__card-wrap {
  padding: 0 32rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.profile__card {
  background: var(--card);
  border-radius: 44rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 48rpx rgba(0,0,0,0.10);
}

.profile__card-top {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.profile__avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: var(--mint-grad);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  box-shadow: 0 8rpx 28rpx rgba(78,205,196,0.4);
  overflow: hidden;
  border: none;
}

.profile__avatar-img {
  width: 100%;
  height: 100%;
}

.profile__info {
  flex: 1;
}

.profile__name {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text);
}

.profile__id {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.profile__edit {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background: var(--mint-light);
  border: 3rpx solid var(--mint);
  color: var(--mint);
  font-size: 26rpx;
  font-weight: 700;
}

/* 统计行 */
.profile__stats {
  display: flex;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--border);
}

.profile__stat {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid var(--border);
}

.profile__stat:last-child {
  border-right: none;
}

.profile__stat-value {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--mint);
}

.profile__stat-label {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

/* 功能列表 */
.profile__menu-wrap {
  padding: 32rpx 32rpx 48rpx;
}

.profile__menu {
  background: var(--card);
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 28rpx rgba(0,0,0,0.06);
}

.profile__menu-item {
  padding: 32rpx 36rpx;
  border-bottom: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 28rpx;
  transition: background 0.15s;
}

.profile__menu-item:active {
  background: #F5F6F7;
}

.profile__menu-item:last-child {
  border-bottom: none;
}

.profile__menu-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: var(--mint-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.profile__menu-text {
  flex: 1;
}

.profile__menu-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}

.profile__menu-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.profile__menu-arrow {
  color: var(--text-sub);
  font-size: 36rpx;
}