# 服务端口
PORT=3000

# MongoDB 连接串（前期开发先用本地，固定测试数据见 scripts/seed.js）
MONGO_URI=mongodb://127.0.0.1:27017/scorekeeper

# 线上 MongoDB（来自 database_config.md，明文口令见该文件；前期开发可先用本地）
# MONGO_URI=mongodb://scorekeeper:<pwd>@40.108.90.72:27017/scorekeeper?authSource=scorekeeper

# JWT 密钥与有效期
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

# 微信小程序 AppID 与 Secret（wx.login -> code2session / 二维码生成）
# 待确认事项1：使用测试号还是正式号
WX_APP_ID=
WX_SECRET=

# 允许跨域来源
CLIENT_ORIGIN=*
